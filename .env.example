# Copy to .env for local development. Never commit .env.

# Claude API key (server-side only).
ANTHROPIC_API_KEY=
# Default production model; set claude-opus-5-5 for harder reasoning during development.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# Optional contact address for the Crossref polite pool. If set, it is sent to Crossref in the
# User-Agent header only (never in URLs). If left empty, no address is sent.
CROSSREF_MAILTO=

# The reading list's database: SQLite locally; Neon Postgres in production. Paste Neon's
# connection string as given (postgresql://USER:PASSWORD@HOST/DB?sslmode=require); it is mapped to
# the psycopg driver automatically. Keep real credentials out of git: set it in Render's
# environment settings, never in this file.
DATABASE_URL=sqlite:///./data/app.db

# Cost/abuse limits (in memory, per process). After MAX_DAILY_MODEL_CALLS model calls in a UTC
# day, answers continue using the deterministic fallbacks (marked "degraded"); 0 never calls the
# model. ASK_RATE_LIMIT_PER_MINUTE limits questions per client address; 0 disables it.
MAX_DAILY_MODEL_CALLS=500
ASK_RATE_LIMIT_PER_MINUTE=20
# Reading-list saves per client address per minute (separate from questions), and the most papers
# one client id may keep saved. 0 disables either.
SAVE_RATE_LIMIT_PER_MINUTE=20
MAX_SAVED_PER_CLIENT=200
